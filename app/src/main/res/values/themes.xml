<resources>
    <!-- The camera is always dark (viewfinder and splash), whatever the phone's theme, so there is no light flash at launch. -->
    <style name="Theme.Camera" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cb_dark</item>
        <item name="android:windowSplashScreenBackground">@color/cb_dark</item>
    </style>
</resources>
